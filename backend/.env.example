# Get the connection string from Supabase: Project Settings > Database > Connect.
# Keep this file local as .env; never commit the actual password.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Comma-separated frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set strong, private values in your real .env.
JWT_SECRET=replace-with-a-long-random-secret
PAYMENT_WEBHOOK_SECRET=replace-with-your-webhook-secret
